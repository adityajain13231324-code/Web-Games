{
  "name": "apartment-07", "version": "1.0.0", "private": true, "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/index.ts", "dev:client": "vite --host 127.0.0.1",
    "check": "tsc --noEmit", "test": "tsx --test tests/*.test.ts",
    "test:network": "tsx --test tests/network/*.test.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js"
  },
  "dependencies": { "@colyseus/core": "^0.16.0", "@colyseus/ws-transport": "^0.16.0", "colyseus.js": "^0.16.0", "phaser": "^3.90.0", "express": "^4.21.2", "cors": "^2.8.5" },
  "devDependencies": { "@types/cors": "^2.8.17", "@types/express": "^4.17.21", "@types/node": "^22.10.0", "concurrently": "^9.1.0", "esbuild": "^0.25.0", "tsx": "^4.19.0", "typescript": "^5.7.0", "vite": "^6.1.0" }
}
